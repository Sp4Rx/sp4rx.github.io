{
  "name": "suvajit-portfolio",
  "private": true,
  "version": "0.0.0",
  "description": "Portfolio and resume of Suvajit Sarkar, with an interactive CSS 3D stack picker and an auto-generated ATS-friendly PDF",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "check": "tsx scripts/check.ts",
    "preview": "vite preview",
    "start:preview:detached": "tsx scripts/startPreview.ts",
    "wait-for-preview": "tsx scripts/waitForPreview.ts",
    "kill:preview": "tsx scripts/killPreview.ts",
    "generate:pdf": "npm run build && npm run start:preview:detached && npm run wait-for-preview && tsc && tsx scripts/generateResumePDF.ts && npm run kill:preview",
    "predeploy": "npm run check && npm run generate:pdf",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "lucide-react": "^0.462.0",
    "playwright": "^1.65.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "gh-pages": "^6.3.0",
    "globals": "^15.9.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^7.2.7",
    "vite-plugin-html": "^3.2.2"
  }
}
